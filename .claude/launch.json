{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "joel-servicios-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "joel-servicios-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "facturafacil-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/Users/Usuario/Desktop/auditoria-facturafacil",
        "run",
        "dev"
      ],
      "port": 3210
